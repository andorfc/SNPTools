# Genotype HDF5 store — large binary data, NEVER committed to git.
#
# processForm.php ($VERSION_PATH = './hdf5/grin2026/') expects per-chromosome
# files in grin2026/, named <family>_<chr>_<quality>.h5, e.g.:
#
#   grin2026/maizegdb2026_chr10_HQ.h5   (MaizeGDB 2026, High Quality)
#   grin2026/maizegdb2026_chr10_HC.h5   (MaizeGDB 2026, High Coverage)
#   grin2026/maizegdb2024_chr10_HQ.h5
#   grin2026/schnable2023_chr10_impute.h5
#   grin2026/zmgrin2026_chr10_impute.h5  (MaizeGDB GRIN-linked 2026, imputed; build with
#                                         tools/vcf_to_h5.py from the release VCFs)
#   grin2026/nam2021_chr10_HQ.h5
#
# Obtain these from the data owner / collaborator and drop them in place;
# they are intentionally kept out of the repo.

# Ignore everything in this directory ...
*
# ... except this file and the grin2026/ folder skeleton.
!.gitignore
!grin2026/
grin2026/*
!grin2026/.gitkeep
